# Copia este archivo a .env y ajusta los valores (no contiene credenciales reales).
DATABASE_URL=mysql+pymysql://USUARIO:CONTRASENA@127.0.0.1:3309/mascaritas?charset=utf8mb4
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# `development` (por defecto) o `production`. En producción se exige una
# JWT_SECRET fuerte y se desactivan /docs, /redoc y /openapi.json.
ENVIRONMENT=development

# Orígenes permitidos por CORS, separados por comas.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Credenciales de MySQL para docker-compose (el compose las lee del .env)
MYSQL_DATABASE=mascaritas
MYSQL_USER=cambia-este-usuario
MYSQL_PASSWORD=cambia-esta-contrasena
MYSQL_ROOT_PASSWORD=cambia-esta-contrasena

# --- Panel admin ---
# Clave para firmar los tokens de sesión. Genera una distinta en producción
# (mínimo 32 caracteres; en producción la API no arranca con la de ejemplo).
JWT_SECRET=cambia-este-secreto-en-produccion
JWT_EXPIRES_MINUTES=480

# Freno contra la fuerza bruta en el login (intentos fallidos por cuenta).
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300

# Credenciales del primer admin (las usa `python -m app.create_admin`).
ADMIN_EMAIL=admin@mascaritasgdl.com
ADMIN_PASSWORD=cambia-esta-contrasena
ADMIN_NAME=Administrador
